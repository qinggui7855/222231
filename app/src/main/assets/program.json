{
  "name": "情系刀塔 · 刷图 + 星际商人采购",
  "refW": 2510,
  "refH": 1156,
  "scale": 2,
  "maxRunMs": 21600000,
  "vars": { "c": 0, "r": 0 },
  "program": [
    { "op": "label", "name": "start" },
    { "op": "log", "msg": "▶ 定位当前界面…" },
    { "op": "if", "t": ["shop_open.png"], "goto": "buy1" },
    { "op": "if", "t": ["chapter7_node.png"], "thr": 0.85, "goto": "enter_stage" },
    { "op": "if", "t": ["campaign_btn.png"], "goto": "to_chapter" },
    { "op": "if", "t": ["stage_play.png"], "goto": "battle" },
    { "op": "if", "t": ["result_refresh.png"], "goto": "click_refresh" },
    { "op": "if", "t": ["merchant_fig.png"], "goto": "enter_shop" },
    { "op": "tap", "t": ["back_arrow.png"], "timeoutMs": 900, "goto": "start" },
    { "op": "sleep", "ms": 1400 },
    { "op": "goto", "label": "start" },

    { "op": "label", "name": "battle" },
    { "op": "if", "t": ["merchant_banner.png", "merchant_banner_edge.png"], "thr": 0.90, "goto": "merchant_trip" },
    { "op": "if", "t": ["result_refresh.png"], "goto": "click_refresh" },
    { "op": "if", "t": ["stage_play.png"], "goto": "click_play" },
    { "op": "sleep", "ms": 400 },
    { "op": "goto", "label": "battle" },

    { "op": "label", "name": "click_play" },
    { "op": "tap", "t": ["stage_play.png"], "timeoutMs": 1200, "goto": "battle" },
    { "op": "sleep", "ms": 1400 },
    { "op": "goto", "label": "battle" },

    { "op": "label", "name": "click_refresh" },
    { "op": "tap", "t": ["result_refresh.png"], "timeoutMs": 1200, "goto": "battle" },
    { "op": "sleep", "ms": 1400 },
    { "op": "goto", "label": "battle" },

    { "op": "label", "name": "merchant_trip" },
    { "op": "log", "msg": "⚡ 星际商人来了，去采购" },
    { "op": "if", "t": ["result_refresh.png"], "goto": "back_to_stage" },
    { "op": "if", "t": ["stage_play.png"], "goto": "leave_stage" },
    { "op": "sleep", "ms": 500 },
    { "op": "goto", "label": "merchant_trip" },

    { "op": "label", "name": "back_to_stage" },
    { "op": "tap", "t": ["result_refresh.png"], "timeoutMs": 1500, "goto": "merchant_trip" },
    { "op": "sleep", "ms": 1400 },
    { "op": "goto", "label": "merchant_trip" },

    { "op": "label", "name": "leave_stage" },
    { "op": "tap", "t": ["back_arrow.png"], "timeoutMs": 1500, "goto": "merchant_trip" },
    { "op": "sleep", "ms": 1600 },
    { "op": "goto", "label": "hub_scan" },

    { "op": "label", "name": "hub_scan" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "hub_loop" },
    { "op": "if", "t": ["merchant_fig.png"], "goto": "enter_shop" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 6, "goto": "hub_back_init" },
    { "op": "swipe", "x": 0.28, "y": 0.55, "x2": 0.82, "y2": 0.55, "ms": 350 },
    { "op": "sleep", "ms": 800 },
    { "op": "goto", "label": "hub_loop" },

    { "op": "label", "name": "hub_back_init" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "hub_back_loop" },
    { "op": "if", "t": ["merchant_fig.png"], "goto": "enter_shop" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 12, "goto": "trip_abort" },
    { "op": "swipe", "x": 0.82, "y": 0.55, "x2": 0.28, "y2": 0.55, "ms": 350 },
    { "op": "sleep", "ms": 800 },
    { "op": "goto", "label": "hub_back_loop" },

    { "op": "label", "name": "trip_abort" },
    { "op": "log", "msg": "⚠ 在主城没找到商人，先回去继续刷图" },
    { "op": "add", "var": "r", "val": 1 },
    { "op": "ifgt", "var": "r", "val": 3, "goto": "fail" },
    { "op": "goto", "label": "start" },

    { "op": "label", "name": "enter_shop" },
    { "op": "tap", "t": ["merchant_fig.png"], "timeoutMs": 2000, "goto": "hub_scan" },
    { "op": "sleep", "ms": 1900 },
    { "op": "wait", "t": ["shop_open.png"], "timeoutMs": 5000, "thr": 0.90, "goto": "hub_scan" },
    { "op": "if", "t": ["sell_dialog_ok.png"], "timeoutMs": 2500, "thr": 0.86, "goto": "dismiss_sell" },
    { "op": "goto", "label": "shop_ready" },

    { "op": "label", "name": "dismiss_sell" },
    { "op": "log", "msg": "🧹 先关掉「是否卖给商人」弹窗" },
    { "op": "tap", "t": ["sell_dialog_ok.png"], "timeoutMs": 2000, "thr": 0.86, "goto": "shop_ready" },
    { "op": "sleep", "ms": 1300 },
    { "op": "goto", "label": "shop_ready" },

    { "op": "label", "name": "shop_ready" },
    { "op": "log", "msg": "🛒 商店已开，采购 1/2/3 号箱子" },
    { "op": "goto", "label": "buy1" },

    { "op": "label", "name": "buy1" },
    { "op": "tapxy", "x": 0.301, "y": 0.551 },
    { "op": "if", "t": ["shop_dialog_ok.png"], "timeoutMs": 2000, "goto": "do_buy1" },
    { "op": "goto", "label": "buy2" },
    { "op": "label", "name": "do_buy1" },
    { "op": "tap", "t": ["shop_dialog_ok.png"], "timeoutMs": 1500, "goto": "buy2" },
    { "op": "sleep", "ms": 1300 },
    { "op": "goto", "label": "buy2" },

    { "op": "label", "name": "buy2" },
    { "op": "tapxy", "x": 0.500, "y": 0.551 },
    { "op": "if", "t": ["shop_dialog_ok.png"], "timeoutMs": 2000, "goto": "do_buy2" },
    { "op": "goto", "label": "buy3" },
    { "op": "label", "name": "do_buy2" },
    { "op": "tap", "t": ["shop_dialog_ok.png"], "timeoutMs": 1500, "goto": "buy3" },
    { "op": "sleep", "ms": 1300 },
    { "op": "goto", "label": "buy3" },

    { "op": "label", "name": "buy3" },
    { "op": "tapxy", "x": 0.732, "y": 0.551 },
    { "op": "if", "t": ["shop_dialog_ok.png"], "timeoutMs": 2000, "goto": "do_buy3" },
    { "op": "goto", "label": "shop_exit" },
    { "op": "label", "name": "do_buy3" },
    { "op": "tap", "t": ["shop_dialog_ok.png"], "timeoutMs": 1500, "goto": "shop_exit" },
    { "op": "sleep", "ms": 1300 },
    { "op": "goto", "label": "shop_exit" },

    { "op": "label", "name": "shop_exit" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "shop_exit_loop" },
    { "op": "tap", "t": ["back_arrow.png"], "timeoutMs": 1500, "goto": "shop_exit_retry" },
    { "op": "sleep", "ms": 1700 },
    { "op": "goto", "label": "hub_return" },
    { "op": "label", "name": "shop_exit_retry" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 4, "goto": "trip_abort" },
    { "op": "sleep", "ms": 500 },
    { "op": "goto", "label": "shop_exit_loop" },

    { "op": "label", "name": "hub_return" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "hr_loop" },
    { "op": "if", "t": ["campaign_btn.png"], "thr": 0.86, "goto": "to_chapter" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 8, "goto": "hr_back_init" },
    { "op": "swipe", "x": 0.82, "y": 0.55, "x2": 0.28, "y2": 0.55, "ms": 350 },
    { "op": "sleep", "ms": 800 },
    { "op": "goto", "label": "hr_loop" },

    { "op": "label", "name": "hr_back_init" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "hr_back_loop" },
    { "op": "if", "t": ["campaign_btn.png"], "thr": 0.86, "goto": "to_chapter" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 10, "goto": "fail" },
    { "op": "swipe", "x": 0.28, "y": 0.55, "x2": 0.82, "y2": 0.55, "ms": 350 },
    { "op": "sleep", "ms": 800 },
    { "op": "goto", "label": "hr_back_loop" },

    { "op": "label", "name": "to_chapter" },
    { "op": "log", "msg": "🗺 进战役，翻到第七章" },
    { "op": "tap", "t": ["campaign_btn.png"], "timeoutMs": 2000, "thr": 0.86, "goto": "fail" },
    { "op": "sleep", "ms": 1900 },
    { "op": "goto", "label": "flip_left" },

    { "op": "label", "name": "flip_left" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "fl_loop" },
    { "op": "if", "t": ["chapter7_node.png"], "thr": 0.85, "goto": "enter_stage" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 20, "goto": "flip_right" },
    { "op": "tap", "t": ["chapter_left.png"], "timeoutMs": 900, "thr": 0.86, "goto": "fl_retry" },
    { "op": "sleep", "ms": 650 },
    { "op": "goto", "label": "fl_loop" },
    { "op": "label", "name": "fl_retry" },
    { "op": "sleep", "ms": 350 },
    { "op": "goto", "label": "fl_loop" },

    { "op": "label", "name": "flip_right" },
    { "op": "set", "var": "c", "val": 0 },
    { "op": "label", "name": "fr_loop" },
    { "op": "if", "t": ["chapter7_node.png"], "thr": 0.85, "goto": "enter_stage" },
    { "op": "add", "var": "c", "val": 1 },
    { "op": "ifgt", "var": "c", "val": 24, "goto": "trip_abort" },
    { "op": "tap", "t": ["chapter_right.png"], "timeoutMs": 900, "thr": 0.86, "goto": "fr_retry" },
    { "op": "sleep", "ms": 650 },
    { "op": "goto", "label": "fr_loop" },
    { "op": "label", "name": "fr_retry" },
    { "op": "sleep", "ms": 350 },
    { "op": "goto", "label": "fr_loop" },

    { "op": "label", "name": "enter_stage" },
    { "op": "log", "msg": "✅ 到达第七章，点关卡回图一" },
    { "op": "tap", "t": ["chapter7_node.png"], "timeoutMs": 2500, "thr": 0.85, "goto": "fail" },
    { "op": "sleep", "ms": 2000 },
    { "op": "set", "var": "r", "val": 0 },
    { "op": "goto", "label": "battle" },

    { "op": "label", "name": "fail" },
    { "op": "log", "msg": "⚠ 流程走丢：找不到关键按钮，请人工看一眼游戏" },
    { "op": "stop", "msg": "已停止" }
  ]
}
